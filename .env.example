# Copy these names into your local shell or environment manager.
# Do not commit real API keys.

TMDB_API_KEY=replace_with_your_tmdb_api_key
OMDB_API_KEY=replace_with_your_omdb_api_key

# Optional: only needed if you add TMDb bearer-token requests.
TMDB_BEARER_TOKEN=replace_with_your_tmdb_bearer_token
